# Database (Supabase / PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Session — generate with: openssl rand -base64 32
SESSION_SECRET=your_random_session_secret_here

# Apify (for Instagram data scraping)
APIFY_TOKEN=apify_api_xxx

# Email (Resend)
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Paddle (server-side)
PADDLE_API_KEY=pdl_sdbx_apikey_xxx
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxx
PADDLE_ENVIRONMENT=sandbox

# Paddle (client-side — Vite exposes VITE_* to browser)
VITE_PADDLE_ENVIRONMENT=sandbox
VITE_PADDLE_CLIENT_TOKEN=test_xxx
VITE_PADDLE_PRICE_PLUS=pri_xxx_plus
VITE_PADDLE_PRICE_PRO=pri_xxx_pro

# Razorpay — INR checkout for visitors in India (Plus ₹399, Pro ₹999).
# Server-side only; the key id reaches the browser through the API, so no
# VITE_ build arg is needed. Until all four of KEY_ID, KEY_SECRET, PLAN_PLUS and
# PLAN_PRO are set, INR checkout returns "not available yet" (USD is unaffected).
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
# Dashboard → Account & Settings → Webhooks, URL https://<domain>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=xxx
# Dashboard → Subscriptions → Plans: monthly plans of ₹399 and ₹999
RAZORPAY_PLAN_PLUS=plan_xxx_plus
RAZORPAY_PLAN_PRO=plan_xxx_pro

# Cloudflare Turnstile — bot check on signup.
# Secret is server-side and verified at /api/auth/register. In production a
# missing secret rejects EVERY registration (the check fails closed); locally,
# leaving it blank skips verification so you can still sign up.
TURNSTILE_SECRET_KEY=
# Site key is public. VITE_ is the one the client actually reads, and Vite
# inlines it at BUILD time — it must also be a Docker build arg / GitHub secret,
# not just a runtime env var on the VPS.
TURNSTILE_SITE_KEY=
VITE_TURNSTILE_SITE_KEY=

# Admin — the server refuses to start without this
SUPER_ADMIN_EMAIL=admin@yourdomain.com

# Test credentials (only needed to run tests/app.test.ts and tests/api-test.mjs)
# Generate passwords with: openssl rand -base64 24
TEST_FOUNDER_EMAIL=founder@example.local
TEST_FOUNDER_PASSWORD=
TEST_ADMIN_EMAIL=admin@example.local
TEST_ADMIN_PASSWORD=
